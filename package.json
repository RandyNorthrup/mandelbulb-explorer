{
  "name": "mandelbulb-explorer",
  "version": "0.1.1",
  "private": true,
  "description": "Interactive WebGL2 raymarched 3D Mandelbulb explorer.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\" --max-warnings=0 && htmlhint index.html",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deadcode": "knip --treat-config-hints-as-errors && dpdm --no-warning --no-tree --exit-code circular:1 src/main.ts && jscpd src --exit-code 1",
    "security:audit": "npm audit --audit-level=moderate",
    "security:secrets": "gitleaks detect --no-git --redact --verbose --source .",
    "security:sast": "node scripts/run-semgrep.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run deadcode && npm run security:audit && npm run security:sast && npm run security:secrets && npm run build",
    "quality:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run deadcode && npm run security:audit && npm run security:sast && npm run build && npm run lighthouse"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "chrome-devtools-mcp": "1.7.0",
    "chrome-launcher": "1.2.1",
    "dpdm": "4.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "htmlhint": "1.9.2",
    "jscpd": "5.0.16",
    "jsdom": "29.1.1",
    "knip": "6.32.2",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
